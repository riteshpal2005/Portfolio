# ─── Portfolio Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values

# Gmail account that SENDS the emails (your Gmail)
EMAIL_USER=riteshks211@gmail.com

# Gmail App Password (NOT your Gmail login password)
# Go to: Google Account → Security → 2-Step Verification → App Passwords
# Generate one for "Mail" and paste it here
EMAIL_PASS=your_gmail_app_password_here

# Port for the backend server
PORT=3001

# Your deployed frontend URL (for production CORS)
FRONTEND_URL=http://localhost:5173
